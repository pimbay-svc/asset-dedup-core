# development | production | test
NODE_ENV=production

# Log level for pino (trace|debug|info|warn|error|fatal|silent)
LOG_LEVEL=info

# HTTP port core listens on
PORT=3000

# Path to the YAML configuration file
CONFIG_PATH=./config/config.yaml

# Shared volume that core and the subservices (image-hash, video-frame-extract,
# pdf-page-extract) can all reach by path. core writes each uploaded asset here before
# calling any subservice socket, and cleans it up once the asset's pipeline finishes/fails.
ASSET_WORKDIR=./var/assets

# Timeout (ms) for a single subservice socket batch call (extractor or algorithm).
SUBSERVICE_CALL_TIMEOUT_MS=30000
